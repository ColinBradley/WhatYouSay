@page "/topics/{Code}/respond"

<PageTitle>@(mTopic is null ? "Respond" : $"Respond — {mTopic.Title}")</PageTitle>

<Breadcrumb Items="@mCrumbs" />

@if (mTopic is null)
{
    <div class="stack">
        <h1>Topic not found</h1>

        <p class="prose quiet">No topic has the code &ldquo;@Code&rdquo;. Codes are case-sensitive.</p>

        <a href="/">Back to the list</a>
    </div>
}
else
{
    <div class="sections" style="max-width: 44em">
        <section class="stack wide">
            <div class="controls">
                <h1>@mTopic.Title</h1>

                <span class="tag @(mTopic.IsAcceptingResponses ? "good" : null)">
                    @(mTopic.IsAcceptingResponses ? "Open" : "Closed")
                </span>
            </div>

            <p class="prose quiet">@mTopic.Description</p>
        </section>

        @if (this.SavedMessage() is { } saved)
        {
            <div class="notice good banner flash" role="status">@saved</div>
        }

        <form method="post" @formname="respond" @onsubmit="SubmitAsync" class="fields">
            <AntiforgeryToken />

            <h2>@this.FormHeading()</h2>

            @if (mEditing is not null)
            {
                <input type="hidden" name="ResponseId" value="@mEditing.Id" />
            }

            @if (mLockedReason is not null)
            {
                <p class="fine">@mLockedReason</p>
            }

            @if (!mTopic.IsAnonymous)
            {
                <div class="field">
                    <label for="author">@this.NameLabel()</label>

                    <input id="author" name="Author" value="@Author"
                           disabled="@(mLockedReason is not null)" title="@mLockedReason" />
                </div>
            }

            <div class="field">
                <label for="body">Your answer</label>

                <textarea id="body" name="Body" rows="8" autofocus="@(mLockedReason is null)"
                          disabled="@(mLockedReason is not null)" title="@mLockedReason">@Body</textarea>
            </div>

            @if (mError is not null)
            {
                <p style="color: var(--danger)">@mError</p>
            }

            <p class="@(this.BoxesStorageNotice() ? "notice" : "fine")">@this.StorageNotice()</p>

            <div class="controls">
                @if (mEditing is null)
                {
                    <button class="primary" type="submit" name="Intent" value="new"
                            disabled="@(mLockedReason is not null)" title="@mLockedReason">
                        Submit
                    </button>
                }
                else
                {
                    <button class="primary" type="submit" name="Intent" value="save"
                            disabled="@(mLockedReason is not null)" title="@mLockedReason">
                        Save changes
                    </button>

                    <button class="danger" type="submit" name="Intent" value="withdraw"
                            disabled="@(mLockedReason is not null)" title="@mLockedReason">
                        Withdraw this response
                    </button>

                    <a class="button push-end" href="@($"/topics/{Code}/respond")">Write a new response</a>
                }
            </div>
        </form>

        @* Static SSR ends here, so the responder cookie is written while there is still a
           response to write it to. *@
        <RespondFeed TopicId="@mTopic.Id" Code="@Code" ReactorToken="@mToken" EditingId="@mEditing?.Id"
                     @rendermode="InteractiveServer" />
    </div>
}
