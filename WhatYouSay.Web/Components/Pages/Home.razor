@page "/"

<PageTitle>What You Say</PageTitle>

@if (mListings is { Count: 0 })
{
    <p class="quiet">Nothing listed publicly yet. Topics shared by link don&rsquo;t appear here.</p>
}
else if (mListings is not null)
{
    <div class="columns">
        @foreach (var group in Groups())
        {
            <section class="stack wide">
                <h2>@group.Heading</h2>

                <ul class="listing">
                    @foreach (var listing in group.Listings)
                    {
                        <li>
                            <a class="panel stack wide" href="@($"/topics/{listing.Topic.Code}")">
                                <span class="spread">
                                    <span class="loud">@listing.Topic.Title</span>

                                    <span class="controls fine">
                                        @if (listing.Topic.IsAnonymous)
                                        {
                                            <span class="tag">Anonymous</span>
                                        }

                                        @if (listing.HasVisibleSummary)
                                        {
                                            <span class="tag accent">Summary</span>
                                        }

                                        <span>@listing.ResponseCount responses</span>
                                    </span>
                                </span>

                                <span class="fine">@listing.Topic.Description</span>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
}
