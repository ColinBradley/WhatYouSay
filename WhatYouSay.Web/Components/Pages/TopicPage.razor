@page "/topics/{Code}"

<PageTitle>@(mTopic?.Title ?? "Topic")</PageTitle>

<Breadcrumb Items="@mCrumbs" />

@if (mTopic is null)
{
    <h1>Topic not found</h1>
    <p class="text-body-secondary">
        No topic has the code &ldquo;@Code&rdquo;. Codes are case-sensitive.
    </p>
    <a href="/">Back to the list</a>
}
else
{
    <h1>@mTopic.Title</h1>
    <p class="lead">@mTopic.Description</p>

    <div class="d-flex gap-2 mb-4 align-items-center">
        <span class="badge @(mTopic.IsAcceptingResponses ? "text-bg-success" : "text-bg-secondary")">
            @(mTopic.IsAcceptingResponses ? "Open for responses" : "Closed")
        </span>

        @if (mHasVisibleSummary)
        {
            <a class="btn btn-sm btn-outline-info" href="@($"/topics/{Code}/summary")">Read the summary</a>
        }
        else
        {
            <button class="btn btn-sm btn-outline-info" disabled
                    title="No summary has been published for this topic yet.">
                Read the summary
            </button>
        }

        <a class="btn btn-sm btn-outline-secondary ms-auto" href="@($"/topics/{Code}/admin")">Admin</a>
    </div>

    <form method="post" @formname="respond" @onsubmit="SubmitAsync">
        <AntiforgeryToken />

        @if (mOwnResponse is not null)
        {
            <p class="small text-body-secondary">
                This is your response. @(mOwnResponse.UpdatedAt is not null ? "You have edited it." : "")
            </p>
        }

        @if (!mTopic.IsAnonymous)
        {
            <div class="mb-3">
                <label class="form-label" for="author">@this.NameLabel()</label>
                <input class="form-control" id="author" name="Author" value="@Author"
                       disabled="@mFrozen" title="@this.FrozenReason()" />
            </div>
        }

        <div class="mb-3">
            <label class="form-label" for="body">Your answer</label>
            <textarea class="form-control" id="body" name="Body" rows="6"
                      disabled="@mFrozen" title="@this.FrozenReason()">@Body</textarea>
        </div>

        @if (mError is not null)
        {
            <p class="text-danger">@mError</p>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit" name="Intent" value="save"
                    disabled="@mFrozen" title="@this.FrozenReason()">
                @(mOwnResponse is null ? "Submit" : "Save changes")
            </button>

            <button class="btn btn-outline-danger" type="submit" name="Intent" value="withdraw"
                    disabled="@(mFrozen || mOwnResponse is null)"
                    title="@(mOwnResponse is null ? "You have not answered this topic yet." : this.FrozenReason())">
                Withdraw my response
            </button>
        </div>
    </form>

    <p class="small text-body-secondary mt-3">@this.StorageNotice()</p>
}
