@page "/topics/{Code}/admin/summaries/{Id:guid}"

<PageTitle>Edit summary</PageTitle>

<Breadcrumb Items="@mCrumbs" />

@if (mTopic is null)
{
    <h1>Topic not found</h1>
    <a href="/">Back to the list</a>
}
else if (mMissing)
{
    <h1>Summary not found</h1>
    <a href="@($"/topics/{Code}/admin/summaries")">Back to the versions</a>
}
else
{
    @* Static SSR down to here, so AdminSession still has the HttpContext it reads the cookie
       from. The editor below is the one interactive island in the app. *@
    <SummaryEditor TopicId="@mTopic.Id" Code="@Code" SummaryId="@Id"
                   @rendermode="InteractiveServer" />
}
