@page "/surveys/{Code}/summary"
@page "/surveys/{Code}/summary/{SummaryId:guid}"
@using WhatYouSay.Data
@using WhatYouSay.Services
@using WhatYouSay.Web.Markdown

<PageTitle>@(mSurvey is null ? "Summary" : $"Summary — {mSurvey.Title}")</PageTitle>

<Breadcrumb Items="@mCrumbs" />

@if (mSurvey is null)
{
    <h1>Survey not found</h1>
    <p class="text-body-secondary">No survey has the code &ldquo;@Code&rdquo;.</p>
    <a href="/">Back to the list</a>
}
else
{
    <h1>Summary</h1>

    @if (mSummary is null)
    {
        @if (SummaryId is null)
        {
            <div class="alert alert-secondary mt-3">
                No summary has been published for this survey yet.
            </div>
        }
        else
        {
            <div class="alert alert-secondary mt-3">
                That version isn&rsquo;t available.
                <a href="@($"/surveys/{Code}/summary")">See the current summary</a>.
            </div>
        }

        @if (mIsAdmin && mUnpublished > 0)
        {
            <p>
                @mUnpublished unpublished
                @(mUnpublished == 1 ? "version is" : "versions are") waiting for you.
                <a href="@($"/surveys/{Code}/admin/summaries")">Review them</a>.
            </p>
        }
    }
    else
    {
        @if (mVersions.Count > 1)
        {
            <p class="small text-body-secondary">
                Version @this.VersionNumber() of @mVersions.Count
                @foreach (var version in mVersions.Where(v => v.Id != mSummary.Id))
                {
                    <text> · </text>
                    <a href="@($"/surveys/{Code}/summary/{version.Id}")">@version.CreatedAt.ToString("d MMM yyyy")</a>
                    @(version.IsVisibleToPublic ? null : " (unpublished)")
                }
            </p>
        }

        <div class="mb-4">@((MarkupString)SummaryMarkdown.ToHtml(mSummary.Body))</div>

        @if (!mSummary.IsVisibleToPublic)
        {
            <div class="alert alert-warning small">
                This version has not been published. You can see it because you administer
                this survey; nobody else can, and nobody can react to it yet.
                <a href="@($"/surveys/{Code}/admin/summaries")">Publish it</a> to open it up.
            </div>
        }
        else
        {
            <div class="alert alert-light border small">
                @if (mReading.CanReact)
                {
                    <text>
                        You answered this survey, so you can react to anything below that says
                        something. Say what you agree with, what matters most to you, and flag
                        anything that misrepresents what you wrote.
                    </text>
                }
                else
                {
                    <text>
                        Only people who answered this survey can react to it. You can still see
                        what everyone else thought.
                    </text>
                }
            </div>
        }

        <form method="post" @formname="react" @onsubmit="ReactAsync">
            <AntiforgeryToken />

            <CascadingValue Value="@mReading" IsFixed="true">
                <SummaryNodeList Nodes="@mRoots" />
            </CascadingValue>
        </form>
    }
}
