@page "/topics/{Code}/admin/summaries"
@using WhatYouSay.Data

<PageTitle>Summaries</PageTitle>

<Breadcrumb Items="@mCrumbs" />

@if (mTopic is null)
{
    <h1>Topic not found</h1>
    <a href="/">Back to the list</a>
}
else
{
    <h1>Summaries</h1>
    <p class="lead">@mTopic.Title</p>

    @if (mError is not null)
    {
        <div class="alert alert-danger" role="alert">@mError</div>
    }

    <form method="post" @formname="summary-action" @onsubmit="ActAsync">
        <AntiforgeryToken />

        @if (mSummaries.Count == 0)
        {
            <div class="alert alert-secondary">
                No summaries yet. Write one by hand, or close the topic and point an agent
                at <code>/mcp</code> with this topic's summariser token.
            </div>
        }

        <button class="btn btn-primary mb-3" type="submit" name="Action" value="new">
            New empty summary
        </button>

        @if (mSummaries.Count > 0)
        {

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Created</th>
                        <th>By</th>
                        <th>Size</th>
                        <th>State</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var summary in mSummaries)
                    {
                        <tr>
                            <td>@summary.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>
                            <td>@(summary.CreatedBy ?? "unknown")</td>
                            <td class="small text-body-secondary">
                                @summary.Nodes.Count nodes,
                                @SummaryTree.Depth(summary.Roots) deep
                            </td>
                            <td>
                                @if (summary.IsVisibleToPublic)
                                {
                                    <span class="badge text-bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Draft</span>
                                }

                                @if (summary.IsAgentEditable)
                                {
                                    <span class="badge text-bg-info" title="The summariser token can write to this version.">Agent</span>
                                }

                                @if (this.IsOutdated(summary))
                                {
                                    <span class="badge text-bg-warning"
                                          title="@($"Drawn over {summary.ResponseCountAtWrite} responses; there are {mLiveResponses} now.")">
                                        Outdated
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@($"/topics/{Code}/summary/{summary.Id}")">
                                        View
                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@($"/topics/{Code}/admin/summaries/{summary.Id}")">
                                        Edit
                                    </a>

                                    <button class="btn btn-sm btn-outline-primary" type="submit"
                                            name="Action" value="@($"{summary.Id}:publish")"
                                            disabled="@summary.IsVisibleToPublic"
                                            title="@(summary.IsVisibleToPublic ? "Already published." : null)">
                                        Publish
                                    </button>

                                    <button class="btn btn-sm btn-outline-secondary" type="submit"
                                            name="Action" value="@($"{summary.Id}:unpublish")"
                                            disabled="@(!summary.IsVisibleToPublic)"
                                            title="@(summary.IsVisibleToPublic ? null : "Not published, so there is nothing to take back.")">
                                        Unpublish
                                    </button>

                                    <button class="btn btn-sm btn-outline-danger" type="submit"
                                            name="Action" value="@($"{summary.Id}:delete")">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </form>

    <p class="small text-body-secondary">
        Publishing makes a summary visible to everyone with the link and lets anyone react to
        it and comment on it. It also takes the agent off that version; you can hand it back
        from the editor.
    </p>
}
