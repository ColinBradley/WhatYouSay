@page "/topics/{Code}/admin/summaries"
@using WhatYouSay.Data

<PageTitle>Summaries</PageTitle>

<Breadcrumb Items="@mCrumbs" />

@if (mTopic is null)
{
    <div class="stack">
        <h1>Topic not found</h1>

        <a href="/">Back to the list</a>
    </div>
}
else
{
    <div class="stack wide" style="--stack-gap: var(--section-gap)">
        <section class="stack">
            <h1>Summaries</h1>

            <p class="quiet">@mTopic.Title</p>
        </section>

        @if (mError is not null)
        {
            <div class="notice danger" role="alert">@mError</div>
        }

        <form method="post" @formname="summary-action" @onsubmit="ActAsync" class="stack wide">
            <AntiforgeryToken />

            <button class="primary" type="submit" name="Action" value="new">New empty summary</button>

            @if (mSummaries.Count == 0)
            {
                <div class="notice">
                    No summaries yet. Write one by hand, or close the topic and point an agent at
                    <code>/mcp</code> with this topic&rsquo;s summariser token.
                </div>
            }
            else
            {
                <div class="scroll-x">
                    <table>
                        <thead>
                            <tr>
                                <th>Created</th>
                                <th>By</th>
                                <th>Size</th>
                                <th>State</th>
                                <th style="text-align: end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var summary in mSummaries)
                            {
                                <tr>
                                    <td>@summary.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>

                                    <td>@summary.CreatedBy</td>

                                    <td class="fine">
                                        @summary.Nodes.Count nodes,
                                        @SummaryTree.Depth(summary.Roots) deep
                                    </td>

                                    <td>
                                        <span class="tag @(summary.IsVisibleToPublic ? "good" : "warn")">
                                            @(summary.IsVisibleToPublic ? "Published" : "Draft")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="controls" style="justify-content: end">
                                            <a class="button" href="@($"/topics/{Code}/summary/{summary.Id}")">View</a>

                                            <a class="button" href="@($"/topics/{Code}/admin/summaries/{summary.Id}")">Edit</a>

                                            <button type="submit" name="Action"
                                                    value="@($"{summary.Id}:publish")"
                                                    disabled="@summary.IsVisibleToPublic"
                                                    title="@(summary.IsVisibleToPublic ? "Already published." : null)">
                                                Publish
                                            </button>

                                            <button type="submit" name="Action"
                                                    value="@($"{summary.Id}:unpublish")"
                                                    disabled="@(!summary.IsVisibleToPublic)"
                                                    title="@(summary.IsVisibleToPublic ? null : "Not published, so there is nothing to take back.")">
                                                Unpublish
                                            </button>

                                            <button class="danger" type="submit" name="Action"
                                                    value="@($"{summary.Id}:delete")">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </form>

        <p class="fine" style="max-width: 52em">
            Publishing makes a summary visible to everyone with the link and lets anyone react to it
            and comment on it. It also takes the agent off that version; you can hand it back from
            the editor.
        </p>
    </div>
}
