@page "/new"
@using WhatYouSay.Data

<PageTitle>New topic</PageTitle>

<Breadcrumb Items="@mCrumbs" />

@if (mCreated is not null)
{
    <div class="sections" style="max-width: 40em">
        <section class="stack">
            <h1>Topic created</h1>

            <p class="quiet">@mCreated.Topic.Title</p>
        </section>

        <section class="stack wide">
            <h2>Share this link</h2>

            <textarea id="share-link" rows="1" readonly>@mShareLink</textarea>

            <button type="button" onclick="whatYouSayCopy(document.getElementById('share-link'), this)">
                Copy link
            </button>
        </section>

        <section class="stack wide">
            <h2>Summariser token</h2>

            <div class="notice warn stack wide">
                <div class="loud">Copy this now &mdash; it is not shown again.</div>

                <textarea id="new-token" rows="2" readonly>@mCreated.SummariserToken</textarea>

                <button type="button" onclick="whatYouSayCopy(document.getElementById('new-token'), this)">
                    Copy token
                </button>

                <p class="fine">
                    Give it to an agent along with the topic code to let it draft summaries. It
                    cannot read your admin password, edit responses, or publish anything.
                </p>
            </div>
        </section>

        <a class="button primary" href="@($"/topics/{mCreated.Topic.Code}/admin")">Go to admin</a>
    </div>
}
else
{
    <div class="stack wide" style="max-width: 40em">
        <h1>New topic</h1>

        <p class="quiet">One open question. Everything else is a setting.</p>

        <form method="post" @formname="create-topic" @onsubmit="CreateAsync" class="fields">
            <AntiforgeryToken />

            <div class="field">
                <label for="title">Title</label>
                <input id="title" name="Title" value="@Title" placeholder="@mExample.Title" autofocus />
            </div>

            <div class="field">
                <label for="prompt">The question</label>
                <textarea id="prompt" name="Prompt" rows="3" placeholder="@mExample.Prompt">@Prompt</textarea>
                <span class="fine">Title and question together are the whole topic.</span>
            </div>

            <div class="field">
                <label for="password">Admin password</label>
                <input id="password" name="Password" type="password" value="@Password" />
                <span class="fine">Only its hash is stored, so it cannot be recovered.</span>
            </div>

            <fieldset class="stack wide">
                <legend>Who has to say who they are?</legend>

                @foreach (var identity in Enum.GetValues<ResponseIdentity>())
                {
                    <label class="check">
                        <input type="radio" name="Identity" id="@($"identity-{identity}")"
                               value="@identity" checked="@(Identity == identity)" />

                        <span>
                            <span class="loud">@identity</span>
                            <span class="fine"> &mdash; @Explain(identity)</span>
                        </span>
                    </label>
                }

                <span class="fine">Fixed once the first response arrives, so choose carefully.</span>
            </fieldset>

            <div class="stack wide">
                <label class="check">
                    <input type="checkbox" id="listed" name="IsPubliclyListed" value="true"
                           checked="@IsPubliclyListed" />
                    Show on the home page
                </label>

                <label class="check">
                    <input type="checkbox" id="responsesPublic" name="AreResponsesPublic" value="true"
                           checked="@AreResponsesPublic" />
                    Show the raw responses beside the summary
                </label>
            </div>

            @if (mError is not null)
            {
                <p style="color: var(--danger)">@mError</p>
            }

            <button class="primary" type="submit">Create topic</button>
        </form>
    </div>
}
