@page "/topics/{Code}/admin"
@using WhatYouSay.Data
@using WhatYouSay.Services

<PageTitle>@(mTopic is null ? "Admin" : $"Admin — {mTopic.Title}")</PageTitle>

<Breadcrumb Items="@mCrumbs" />

@if (mTopic is null)
{
    <div class="stack">
        <h1>Topic not found</h1>

        <p class="quiet">No topic has the code &ldquo;@Code&rdquo;.</p>

        <a href="/">Back to the list</a>
    </div>
}
else if (!mIsAdmin)
{
    <div class="stack wide" style="max-width: 24em">
        <h1>Admin</h1>

        <p class="quiet">@mTopic.Title</p>

        <form method="post" @formname="admin-signin" @onsubmit="SignInAsync" class="fields">
            <AntiforgeryToken />

            <div class="field">
                <label for="password">Admin password</label>
                <input id="password" name="Password" type="password" autofocus />
            </div>

            @if (mError is not null)
            {
                <p style="color: var(--danger)">@mError</p>
            }

            <button class="primary" type="submit">Sign in</button>
        </form>
    </div>
}
else
{
    <div class="sections">
        <section class="stack">
            <h1>Admin</h1>

            <p class="quiet">@mTopic.Title</p>
        </section>

        @if (mError is not null)
        {
            <div class="notice danger" role="alert">@mError</div>
        }

        <div class="columns">
            <section class="stack wide">
                <h2>This topic</h2>

                <dl class="facts">
                    <dt>Share link</dt>
                    <dd><code>@mShareLink</code></dd>

                    <dt>Responses</dt>
                    <dd>@mResponseCount</dd>

                    <dt>Summaries</dt>
                    <dd>@mSummaryCount</dd>

                    <dt>Identity</dt>
                    <dd>@mTopic.ResponseIdentity</dd>

                    <dt>Timing</dt>
                    <dd>@(mTopic.RecordsTiming ? "Recorded, newest first" : "Not recorded")</dd>
                </dl>

                <div class="controls">
                    <a class="button" href="@($"/topics/{Code}/admin/responses")">Responses</a>
                    <a class="button" href="@($"/topics/{Code}/admin/summaries")">Summaries</a>
                    <a class="button" href="@($"/topics/{Code}")">View as responder</a>
                </div>

                <h2>Collecting</h2>

                @if (mTopic.IsAcceptingResponses)
                {
                    <p class="fine">
                        Closing stops new responses arriving. It freezes nothing, so people can
                        still edit or withdraw what they wrote. You can reopen whenever you like.
                    </p>

                    <form method="post" @formname="admin-close" @onsubmit="CloseAsync">
                        <AntiforgeryToken />
                        <button type="submit">Close to new responses</button>
                    </form>
                }
                else
                {
                    <p class="fine">
                        This topic is closed to new responses. People can still edit or withdraw
                        what they wrote, unless you freeze it.
                    </p>

                    <form method="post" @formname="admin-reopen" @onsubmit="ReopenAsync">
                        <AntiforgeryToken />
                        <button type="submit">Reopen</button>
                    </form>
                }

                <h2>Editing</h2>

                <p class="fine">
                    @mFrozenCount of @mResponseCount @(mResponseCount == 1 ? "response is" : "responses are")
                    frozen. A frozen response cannot be edited or withdrawn by the person who wrote
                    it until you allow editing again. Responses that arrive after a freeze start
                    editable.
                </p>

                <form method="post" @formname="admin-freeze" @onsubmit="SetFrozenAsync" class="controls">
                    <AntiforgeryToken />

                    <button type="submit" name="FreezeResponses" value="true"
                            disabled="@(this.FreezeReason is not null)" title="@this.FreezeReason">
                        Freeze responses
                    </button>

                    <button type="submit" name="FreezeResponses" value="false"
                            disabled="@(this.ThawReason is not null)" title="@this.ThawReason">
                        Allow editing
                    </button>
                </form>

                <h2>Summary updates</h2>

                @if (this.IsLive)
                {
                    <p class="fine">
                        Live: the summariser keeps one live summary up to date, and readers see
                        each update as soon as it is accepted. You can edit the live summary too.
                    </p>

                    @if (mLiveSummary is null)
                    {
                        <p class="fine">
                            There is no live summary yet. The summariser&rsquo;s first new summary
                            becomes it, or you can make one live from
                            <a href="@($"/topics/{Code}/admin/summaries")">Summaries</a>.
                        </p>
                    }
                    else
                    {
                        <p class="fine">
                            The live summary is
                            <a href="@($"/topics/{Code}/summary/{mLiveSummary.Id}")">here</a>
                            (<a href="@($"/topics/{Code}/admin/summaries/{mLiveSummary.Id}")">edit</a>).
                            @(mLiveSummary.IsAgentEditable
                                ? "The summariser is updating it."
                                : "Summariser updates are paused.")
                        </p>
                    }
                }
                else
                {
                    <p class="fine">
                        Reviewed: the summariser writes drafts, and nothing it writes is seen until
                        you publish it.
                    </p>
                }

                <form method="post" @formname="admin-summary-updates" @onsubmit="SetSummaryUpdatesAsync" class="controls">
                    <AntiforgeryToken />

                    <button type="submit" name="SummaryUpdates" value="pause"
                            disabled="@(this.PauseReason is not null)" title="@this.PauseReason">
                        Pause summariser
                    </button>

                    <button type="submit" name="SummaryUpdates" value="resume"
                            disabled="@(this.ResumeReason is not null)" title="@this.ResumeReason">
                        Resume summariser
                    </button>

                    @if (this.IsLive)
                    {
                        <button type="submit" name="SummaryUpdates" value="review"
                                title="The live summary stays published as an ordinary version, and the summariser writes drafts from then on.">
                            Require review
                        </button>
                    }
                    else
                    {
                        <button type="submit" name="SummaryUpdates" value="live"
                                title="The summariser's next new summary, or one you choose, becomes the live summary.">
                            Publish updates live
                        </button>
                    }
                </form>
            </section>

            <section class="stack wide">
                <h2>Settings</h2>

                <form method="post" @formname="admin-settings" @onsubmit="SaveSettingsAsync" class="stack wide">
                    <AntiforgeryToken />

                    <label class="check">
                        <input type="checkbox" id="listed" name="IsPubliclyListed" value="true"
                               checked="@mTopic.IsPubliclyListed" />
                        Show on the home page
                    </label>

                    <label class="check">
                        <input type="checkbox" id="responsesPublic" name="AreResponsesPublic" value="true"
                               checked="@mTopic.AreResponsesPublic" />
                        Show the raw responses beside the summary
                    </label>

                    <label class="check @(mCanChangeIdentityAndTiming ? null : "quiet")" title="@mFixedReason">
                        <input type="checkbox" id="identity" name="IsAnonymous" value="true"
                               checked="@mTopic.IsAnonymous" disabled="@(!mCanChangeIdentityAndTiming)"
                               title="@mFixedReason" />
                        Anonymous
                    </label>

                    <label class="check @(mCanChangeIdentityAndTiming ? null : "quiet")" title="@mFixedReason">
                        <input type="checkbox" id="timing" name="RecordsTiming" value="true"
                               checked="@mTopic.RecordsTiming" disabled="@(!mCanChangeIdentityAndTiming)"
                               title="@mFixedReason" />
                        Record when responses arrive, and list them newest first
                    </label>

                    <button class="primary" type="submit">Save settings</button>
                </form>

                <h2>Summarising guidance</h2>

                <p class="fine">
                    The summariser reads this alongside the responses every time it writes. All
                    of it is optional. Changing it counts as new feedback, so the next summariser
                    pass takes it into account.
                </p>

                <form method="post" @formname="admin-guidance" @onsubmit="SaveGuidanceAsync" class="stack wide">
                    <AntiforgeryToken />

                    <div class="field">
                        <label for="expected-feedback">Feedback you expect</label>
                        <textarea id="expected-feedback" name="ExpectedFeedback" rows="3"
                                  maxlength="@TopicAdminService.MaxGuidanceLength"
                                  placeholder="Questions for the panel, mostly about the roadmap">@mTopic.ExpectedFeedback</textarea>
                    </div>

                    <div class="field">
                        <label for="summarising-instructions">How to summarise it</label>
                        <textarea id="summarising-instructions" name="SummarisingInstructions" rows="4"
                                  maxlength="@TopicAdminService.MaxGuidanceLength"
                                  placeholder="Group questions by team, and keep any that nobody else asked">@mTopic.SummarisingInstructions</textarea>
                    </div>

                    <div class="field">
                        <label for="length-target">Length to aim for</label>
                        <input id="length-target" name="SummaryLengthTarget" type="text"
                               maxlength="@TopicAdminService.MaxGuidanceLength"
                               placeholder="One screen, five or six main points"
                               value="@mTopic.SummaryLengthTarget" />
                    </div>

                    <button class="primary" type="submit">Save guidance</button>
                </form>

                <h2>Summariser token</h2>

                @if (mNewToken is not null)
                {
                    <div class="notice warn stack wide">
                        <div class="loud">Copy this now &mdash; it is not shown again.</div>

                        <textarea id="new-token" rows="2" readonly>@mNewToken</textarea>

                        <button type="button"
                                onclick="whatYouSayCopy(document.getElementById('new-token'), this)">
                            Copy token
                        </button>
                    </div>
                }
                else
                {
                    <p class="fine">
                        Only its hash is stored, so it cannot be shown again. Regenerating gives you
                        a fresh token and a ready-made prompt, and stops the old token working
                        immediately.
                    </p>
                }

                <form method="post" @formname="admin-token" @onsubmit="RegenerateTokenAsync">
                    <AntiforgeryToken />
                    <button type="submit">Regenerate token</button>
                </form>

                <form method="post" @formname="admin-signout" @onsubmit="SignOut">
                    <AntiforgeryToken />
                    <button class="bare" type="submit">Sign out of admin</button>
                </form>
            </section>
        </div>

        @if (mPrompt is not null)
        {
            <section class="stack wide" style="max-width: 52em">
                <h2>Prompt to hand to an assistant</h2>

                <p class="fine">
                    Points at a URL that explains the whole job, and carries the token. Paste it into
                    any chat whose assistant can make an HTTP request. Treat it like the token itself.
                </p>

                <textarea id="summariser-prompt" rows="9" readonly
                          style="font-family: var(--mono-font); font-size: var(--fine-size)">@mPrompt</textarea>

                <button type="button"
                        onclick="whatYouSayCopy(document.getElementById('summariser-prompt'), this)">
                    Copy prompt
                </button>
            </section>
        }
    </div>
}
