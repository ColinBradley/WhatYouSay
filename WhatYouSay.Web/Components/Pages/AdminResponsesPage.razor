@page "/topics/{Code}/admin/responses"

<PageTitle>Responses</PageTitle>

<Breadcrumb Items="@mCrumbs" />

@if (mTopic is null)
{
    <div class="stack">
        <h1>Topic not found</h1>

        <a href="/">Back to the list</a>
    </div>
}
else
{
    <div class="sections" style="max-width: 52em">
        <section class="stack">
            <h1>Responses</h1>

            <p class="quiet">@mTopic.Title</p>

            @if (mTopic.IsAnonymous)
            {
                <p class="fine">
                    This topic is anonymous, so no names or times were recorded and the order below
                    is meaningless by design.
                </p>
            }
        </section>

        @if (mResponses.Count == 0)
        {
            <div class="notice">Nobody has answered yet.</div>
        }
        else
        {
            <form method="post" @formname="delete-response" @onsubmit="DeleteAsync" class="panels">
                <AntiforgeryToken />

                @foreach (var response in mResponses)
                {
                    <article class="panel stack wide hoverable">
                        <p class="verbatim">@response.Body</p>

                        <div class="controls fine">
                            <span>@(response.Author ?? "anonymous")</span>

                            @if (response.CreatedAt is { } created)
                            {
                                <span>@created.ToLocalTime().ToString("d MMM yyyy HH:mm")</span>
                            }

                            @if (response.UpdatedAt is not null)
                            {
                                <span>edited</span>
                            }

                            <button class="danger push-end on-demand" type="submit"
                                    name="ResponseId" value="@response.Id">
                                Delete
                            </button>
                        </div>
                    </article>
                }
            </form>

            <p class="fine">
                Deleting hides a response and drops it from any summary that quotes it. You cannot
                edit what someone wrote &mdash; that is the one power an admin does not get.
            </p>
        }
    </div>
}
