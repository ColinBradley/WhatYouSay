@using WhatYouSay.Data
@using WhatYouSay.Web.Markdown

<div class="pane" @ref="mPane">
    <div class="pane-head stack">
        <div class="controls">
            <h2>Summary</h2>

            @if (this.View.Summary is { IsLive: true })
            {
                <span class="tag accent"
                      title="An AI summariser writes this from the responses and updates it as they arrive. Nobody reviews an update before it appears.">
                    Live AI summary
                </span>
            }
        </div>

        @if (this.View.Summary is { IsLive: true } live)
        {
            <p class="fine">
                Last updated @this.WhenUpdated(live).
                @if (!live.IsAgentEditable)
                {
                    <text> AI updates are paused.</text>
                }
                @if (live.AppliedInputRevision < this.View.Topic.InputRevision)
                {
                    <text> Newer feedback has arrived since.</text>
                }
                else if (live.AppliedInputRevision == this.View.Topic.InputRevision)
                {
                    <text> It includes all the feedback so far.</text>
                }
            </p>
        }
    </div>

    <div class="stack wide">
        @if (this.View.Summary is not { } summary)
        {
            @if (this.Feed.SummaryId is not null)
            {
                <div class="notice">
                    That version isn&rsquo;t available.
                    <a href="@($"/topics/{this.View.Topic.Code}")">See the current one</a>.
                </div>
            }
            else if (this.View.Topic.SummaryPolicy == SummaryPolicy.Live)
            {
                <div class="notice">
                    No summary yet. An AI summary appears here once the summariser first writes one,
                    and then updates as feedback arrives.
                </div>
            }
            else
            {
                <div class="notice">Nothing has been published for this topic yet.</div>
            }

            @if (this.Unpublished > 0)
            {
                <p>
                    @this.Unpublished unpublished @(this.Unpublished == 1 ? "version is" : "versions are")
                    waiting for you. <a href="@($"/topics/{this.View.Topic.Code}/admin/summaries")">Review them</a>.
                </p>
            }
        }
        else
        {
            @if (this.View.Versions.Count > 1)
            {
                <p class="fine">
                    Version @this.VersionNumber(summary) of @this.View.Versions.Count
                    @foreach (var version in this.View.Versions.Where(v => v.Id != summary.Id))
                    {
                        <text> &middot; </text>
                        <a href="@($"/topics/{this.View.Topic.Code}/summary/{version.Id}")">@version.CreatedAt.ToString("d MMM yyyy")</a>
                        @(version.IsVisibleToPublic ? null : " (unpublished)")
                    }
                </p>
            }

            @if (!summary.IsVisibleToPublic)
            {
                <div class="notice warn">
                    This version has not been published. You can see it because you administer this
                    topic; nobody else can, and nobody can react to it yet.
                    <a href="@($"/topics/{this.View.Topic.Code}/admin/summaries")">Publish it</a> to open it up.
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(summary.Body))
            {
                <div class="prose">@((MarkupString)SummaryMarkdown.ToHtml(summary.Body))</div>
            }

            <SummaryNodeList Nodes="@summary.Roots.ToList()" />
        }
    </div>
</div>
