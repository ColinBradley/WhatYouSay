@using WhatYouSay.Data
@using WhatYouSay.Services

@{
    var comments = this.Editor.CommentsFor(this.Node.Id);
}

<li class="@(this.Editor.IsSelected(this.Node.Id) ? "is-picked" : null)">
    <input class="@(this.Editor.IsUngrounded(this.Node.Id) ? "is-ungrounded" : null)"
           value="@this.Node.Text" disabled="@this.Editor.IsLocked"
           title="@this.Editor.LockedReason"
           @onfocus="() => this.Editor.Select(this.Node.Id)"
           @onchange="@(e => this.Editor.SetTextAsync(this.Node.Id, e.Value?.ToString() ?? string.Empty))" />

    @if (this.Editor.IsUngrounded(this.Node.Id))
    {
        <div class="fine" style="color: var(--warn)">
            Ends a branch with nothing anybody wrote.
        </div>
    }

    @foreach (var reference in this.Node.References)
    {
        <div class="controls fine" style="flex-wrap: nowrap; align-items: start">
            <blockquote class="grow">
                &ldquo;@reference.Quote&rdquo;
                <span class="quiet">&mdash; @(reference.Response.Author ?? "anonymous")</span>

                @if (!reference.IsOnCurrentRevision)
                {
                    <span class="tag" title="The quote keeps the wording it was taken from.">Response edited since</span>
                }
            </blockquote>

            <button class="bare danger" type="button"
                    @onclick="() => this.Editor.DeleteReferenceAsync(reference.Id)"
                    disabled="@this.Editor.IsLocked"
                    title="@(this.Editor.LockedReason ?? "Remove this quote")">
                &times;
            </button>
        </div>
    }

    @foreach (var comment in comments)
    {
        <div class="panel node-comment @(comment.IsHidden ? "is-hidden" : null)">
            <div>@comment.Body</div>

            <div class="controls fine">
                <span>@(comment.Author ?? "anonymous")</span>

                @if (comment.IsHidden)
                {
                    <span class="tag">Hidden</span>
                }

                <button class="bare" type="button"
                        @onclick="() => this.Editor.SetCommentHiddenAsync(comment.Id, !comment.IsHidden)">
                    @(comment.IsHidden ? "Show" : "Hide")
                </button>
            </div>

            @if (comment.CommenterResponses.Count > 0)
            {
                <details>
                    <summary class="fine">
                        What @(comment.Author ?? "they") actually wrote
                        @(comment.CommenterResponses.Count == 1 ? null : $"({comment.CommenterResponses.Count} responses)")
                    </summary>

                    <div class="stack">
                        @foreach (var response in comment.CommenterResponses)
                        {
                            <p class="verbatim fine">@response.Body</p>
                        }
                    </div>
                </details>
            }
            else
            {
                <p class="fine">@(comment.Author ?? "They") did not respond to this topic.</p>
            }
        </div>
    }

    @if (this.Node.Children.Count > 0)
    {
        <ul>
            @foreach (var child in this.Node.Children)
            {
                <SummaryEditNode Node="@child" Depth="@(this.Depth + 1)" />
            }
        </ul>
    }
</li>
