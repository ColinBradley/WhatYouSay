@using WhatYouSay.Data

@* A quoted run names the node it supports, and a citation names the run. app.js moves
   whichever pane the other end lives in. *@

<div class="pane" id="responses">
    <div class="pane-head spread">
        <h2>Responses</h2>
        <span class="fine">@Responses.Count @(Responses.Count == 1 ? "response" : "responses")</span>
    </div>

    @if (Responses.Count == 0)
    {
        <p class="quiet">Nobody answered this one.</p>
    }
    else
    {
        <div class="panels">
            @foreach (var response in Responses)
            {
                <article class="panel stack wide">
                    <p class="verbatim">
                        <QuotedText Body="@response.Current.Body" References="@this.CurrentReferencesFor(response)" Linked="true" />
                    </p>

                    <p class="fine">
                        @(response.Author ?? "anonymous")

                        @if (response.SubmittedAt is { } created)
                        {
                            <text>&middot; @created.ToLocalTime().ToString("d MMM yyyy")</text>
                        }
                    </p>

                    @foreach (var earlier in this.EarlierRevisionsFor(response))
                    {
                        @* app.js opens this when a citation into it is followed. *@
                        <details>
                            <summary class="fine">Edited since it was quoted. What the summary quotes:</summary>

                            <p class="verbatim">
                                <QuotedText Body="@earlier.Revision.Body" References="@earlier.References" Linked="true" />
                            </p>
                        </details>
                    }
                </article>
            }
        </div>
    }
</div>
