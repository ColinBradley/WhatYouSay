@using WhatYouSay.Data

@* A quoted run names the node it supports, and a citation names the run. app.js moves
   whichever pane the other end lives in. *@

<div class="pane stack wide" @ref="mPane">
    @this.Lead

    <div class="pane-head spread">
        <h2>Responses</h2>

        @if (this.View.Topic.RecordsTiming)
        {
            @* app.js shows this, with a count, when responses arrive above a pane scrolled away
               from its start. *@
            <button type="button" class="primary" data-new-arrivals hidden></button>
        }

        <span class="fine">@this.View.Responses.Count @(this.View.Responses.Count == 1 ? "response" : "responses")</span>
    </div>

    @if (!this.View.Topic.RecordsTiming)
    {
        <p class="fine">This topic does not record when responses arrive, so they are in no particular order.</p>
    }

    @if (this.View.Responses.Count == 0)
    {
        <p class="quiet">No responses yet. Each one appears here as soon as it arrives.</p>
    }
    else
    {
        <div class="panels">
            @foreach (var response in this.View.Responses)
            {
                var tally = this.View.TallyFor(response);

                @* Keyed by response, so a response arriving at the top adds a card instead of
                   shifting every card's contents down one. Focus and open details stay with
                   their response. *@
                <article @key="response.Id" class="panel stack wide hoverable">
                    <p class="verbatim">
                        <QuotedText Body="@response.Current.Body" References="@this.CurrentReferencesFor(response)" Linked="true" />
                    </p>

                    <div class="controls">
                        <span class="fine">@(response.Author ?? "anonymous")</span>

                        @if (response.SubmittedAt is { } created)
                        {
                            <span class="fine">@created.ToLocalTime().ToString("d MMM yyyy")</span>
                        }

                        @if (response.IsEdited)
                        {
                            <span class="fine">edited</span>
                        }

                        @* The unused kinds wait for hover or focus in the row the author line
                           already takes up, so hiding them costs no space. *@
                        <div class="reactions" role="group" aria-label="Reactions">
                            <ReactionButtons Tally="@tally" Lit="true"
                                             OnToggle="@(kind => this.Feed.ToggleOnResponseAsync(response.Id, kind))" />

                            <ReactionButtons Tally="@tally" Class="on-demand"
                                             OnToggle="@(kind => this.Feed.ToggleOnResponseAsync(response.Id, kind))" />
                        </div>
                    </div>

                    @foreach (var earlier in this.EarlierRevisionsFor(response))
                    {
                        @* app.js opens this when a citation into it is followed. *@
                        <details @key="earlier.Revision.Number">
                            <summary class="fine">Edited since it was quoted. What the summary quotes:</summary>

                            <p class="verbatim">
                                <QuotedText Body="@earlier.Revision.Body" References="@earlier.References" Linked="true" />
                            </p>
                        </details>
                    }
                </article>
            }
        </div>
    }
</div>
