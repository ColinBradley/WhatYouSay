@using WhatYouSay.Data
@using WhatYouSay.Services

@if (mSummary is null)
{
    <p class="quiet">Loading&hellip;</p>
}
else
{
    <div class="sections">
        <section class="spread">
            <div class="stack">
                <h1>Edit summary</h1>

                <p class="quiet">@mTopic?.Title</p>
            </div>

            <div class="controls">
                <span class="tag @(mSummary.IsVisibleToPublic ? "good" : "warn")">
                    @(mSummary.IsVisibleToPublic ? "Published" : "Draft")
                </span>

                <a class="button" href="@($"/topics/{Code}/summary/{SummaryId}")">View</a>

                <button @onclick="() => SetPublishedAsync(true)"
                        disabled="@mSummary.IsVisibleToPublic"
                        title="@(mSummary.IsVisibleToPublic ? "Already published." : null)">
                    Publish
                </button>

                <button @onclick="() => SetPublishedAsync(false)"
                        disabled="@(!mSummary.IsVisibleToPublic)"
                        title="@(mSummary.IsVisibleToPublic ? null : "Not published, so there is nothing to take back.")">
                    Unpublish
                </button>

                <button class="danger" @onclick="DeleteSummaryAsync">Delete version</button>
            </div>
        </section>

        @if (mError is not null)
        {
            <div class="notice danger" role="alert">@mError</div>
        }

        @if (mNotice is not null)
        {
            <div class="notice good" role="status">@mNotice</div>
        }

        @if (this.IsLocked)
        {
            <div class="notice warn">
                This version is published, so it is read-only. Unpublish it to make changes
                &mdash; people are reading it, and reactions are attached to the nodes as they
                stand.
            </div>
        }

        @if (mUngrounded.Count > 0)
        {
            <div class="notice warn">
                @mUngrounded.Count
                @(mUngrounded.Count == 1 ? "node ends a branch" : "nodes end branches")
                with nothing anybody wrote, marked below. That is worth knowing rather than
                worth fixing: a point you are making yourself is allowed to stand on its own.
            </div>
        }

        @if (mComments.Count > 0)
        {
            <section class="stack wide">
                <h2>
                    @mComments.Count
                    @(mComments.Count == 1 ? "comment" : "comments")
                    on this summary
                </h2>

                <p class="fine">
                    What the group said back, in their words. Where the commenter also responded to
                    the topic, their own answer is one click away.
                </p>

                <div class="panels">
                    @foreach (var comment in mComments)
                    {
                        <div class="panel stack wide">
                            <div class="loud">
                                @comment.NodeText

                                @if (comment.IsHidden)
                                {
                                    <span class="tag">Hidden</span>
                                }
                            </div>

                            <div>@comment.Body</div>

                            @if (comment.ResponseBody is not null)
                            {
                                <details>
                                    <summary class="fine">
                                        What @(comment.Author ?? "they") actually wrote
                                    </summary>

                                    <p class="verbatim fine" style="margin-top: 0.5em">@comment.ResponseBody</p>
                                </details>
                            }
                            else
                            {
                                <p class="fine">
                                    @(comment.Author ?? "They") did not respond to this topic.
                                </p>
                            }

                            <button type="button"
                                    @onclick="() => this.SetCommentHiddenAsync(comment.Id, !comment.IsHidden)">
                                @(comment.IsHidden ? "Show" : "Hide")
                            </button>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="stack wide" style="max-width: 52em">
            <h2>Overview</h2>

            <p class="fine">
                Two or three paragraphs of markdown about what people said. Not a restatement of the
                tree &mdash; that is what stops the two drifting apart.
            </p>

            <textarea rows="8" @bind="mBody" disabled="@this.IsLocked" title="@this.LockedReason"></textarea>

            <button class="primary" @onclick="SaveBodyAsync"
                    disabled="@this.IsLocked" title="@this.LockedReason">
                Save overview
            </button>
        </section>

        <section class="stack wide">
            <div class="spread">
                <h2>The tree</h2>

                <span class="fine">
                    @mSummary.Nodes.Count nodes, @SummaryTree.Depth(mSummary.Roots) deep
                </span>
            </div>

            <CascadingValue Value="this" IsFixed="true">
                <ul class="tree">
                    @foreach (var root in mSummary.Roots)
                    {
                        <SummaryEditNode Node="@root" Depth="0" />
                    }
                </ul>
            </CascadingValue>

            <button @onclick="() => AddNodeAsync(null)"
                    disabled="@this.IsLocked" title="@this.LockedReason">
                Add a root node
            </button>
        </section>
    </div>
}
