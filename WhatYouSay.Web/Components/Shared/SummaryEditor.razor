@using WhatYouSay.Data
@using WhatYouSay.Services

@if (mMissing)
{
    <div class="stack">
        <h1>Summary deleted</h1>

        <p class="quiet">This version no longer exists.</p>

        <a href="@($"/topics/{Code}/admin/summaries")">Back to the versions</a>
    </div>
}
else if (mSummary is null)
{
    <p class="quiet">Loading&hellip;</p>
}
else
{
    <div class="sections">
        <section class="spread">
            <div class="stack">
                <h1>Edit summary</h1>

                <p class="quiet">@mTopic?.Title</p>
            </div>

            <div class="controls">
                @if (mSummary.IsLive)
                {
                    <span class="tag accent">Live</span>
                }

                <span class="tag @(mSummary.IsVisibleToPublic ? "good" : "warn")">
                    @(mSummary.IsVisibleToPublic ? "Published" : "Draft")
                </span>

                <a class="button" href="@($"/topics/{Code}/summary/{SummaryId}")">View</a>

                <a class="button" href="@($"/topics/{Code}/admin/summaries/{SummaryId}/archived")">Archived</a>

                <button @onclick="() => SetAgentEditableAsync(!mSummary.IsAgentEditable)"
                        disabled="@(this.AgentAccessReason is not null)" title="@this.AgentAccessReason">
                    @this.AgentAccessLabel
                </button>

                <button @onclick="() => SetPublishedAsync(true)" disabled="@mSummary.IsVisibleToPublic"
                        title="@(mSummary.IsVisibleToPublic ? "Already published." : null)">
                    Publish
                </button>

                <button @onclick="() => SetPublishedAsync(false)" disabled="@(this.UnpublishReason is not null)"
                        title="@this.UnpublishReason">
                    Unpublish
                </button>

                <button class="danger" @onclick="DeleteSummaryAsync">Delete version</button>
            </div>
        </section>

        @if (mError is not null)
        {
            <div class="notice danger" role="alert">@mError</div>
        }

        @if (mNotice is not null)
        {
            <div class="notice good" role="status">@mNotice</div>
        }

        @if (this.IsLocked)
        {
            <div class="notice warn">
                This version is published, so it is read-only. Unpublish it to make changes
                &mdash; people are reading it, and reactions are attached to the nodes as they
                stand.
            </div>
        }

        @if (mSummary.IsLive)
        {
            <div class="notice accent">
                This is the live summary, so readers see each change as soon as you make it.
                @if (mSummary.IsAgentEditable)
                {
                    <text>
                        The summariser keeps updating it as well. A summariser write based on a
                        version from before your change is refused, but a later one may rework
                        what you wrote, so pause the summariser while you make larger changes.
                    </text>
                }
                else
                {
                    <text>Summariser updates are paused.</text>
                }
            </div>
        }

        @if (mUngrounded.Count > 0)
        {
            <div class="notice warn">
                @mUngrounded.Count
                @(mUngrounded.Count == 1 ? "node ends a branch" : "nodes end branches")
                with nothing anybody wrote, marked below. That is worth knowing rather than
                worth fixing: a point you are making yourself is allowed to stand on its own.
            </div>
        }

        <section class="stack wide" style="max-width: 52em">
            <h2>Overview</h2>

            <p class="fine">
                Two or three paragraphs of markdown about what people said. Not a restatement of the
                tree &mdash; that is what stops the two drifting apart.
            </p>

            @* Bound per keystroke, so a reload can tell an unsaved edit from what is stored. *@
            <textarea rows="8" @bind="mBody" @bind:event="oninput" disabled="@this.IsLocked" title="@this.LockedReason"></textarea>

            @if (mBodyChanged)
            {
                <div class="notice warn" role="status">
                    Someone else saved the overview while you were editing it. Saving yours replaces theirs.
                </div>
            }

            <button class="primary" @onclick="SaveBodyAsync" disabled="@this.IsLocked" title="@this.LockedReason">
                Save overview
            </button>
        </section>

        <section class="stack wide">
            <div class="spread">
                <h2>Note Tree</h2>

                <span class="fine">
                    @mSummary.Nodes.Count nodes, @SummaryTree.Depth(mSummary.Roots) deep@(mComments.Count > 0 ? $",    {mComments.Count} {(mComments.Count == 1 ? "comment" : "comments")}" : null)
                </span>
            </div>

            <CascadingValue Value="this" IsFixed="true">
                <SummaryEditToolbar Selected="@this.Selected" />

                @* Responses come first in reading order, so they take the inline start and come
                   first when the columns stack. *@
                <div class="@(mResponses.Count > 0 ? "split" : null)">
                    @if (mResponses.Count > 0)
                    {
                        <div class="pane">
                            <div class="pane-head spread">
                                <h3>Responses</h3>

                                <span class="fine">
                                    @(this.Selected is null
                                        ? "Pick a node to quote into"
                                        : "Select text to quote it")
                                </span>
                            </div>

                            <div class="panels">
                                @foreach (var response in mResponses)
                                {
                                    <article @key="response.Id" class="panel stack wide">
                                        <p class="verbatim" data-response="@response.Id">
                                            <QuotedText Body="@response.Current.Body" References="@this.CurrentReferencesFor(response)" />
                                        </p>

                                        <p class="fine">@(response.Author ?? "anonymous")</p>
                                    </article>
                                }
                            </div>
                        </div>
                    }

                    <div class="@(mResponses.Count > 0 ? "pane" : null)">
                        <ul class="tree edit-tree">
                            @foreach (var root in mSummary.Roots)
                            {
                                <SummaryEditNode @key="root.Id" Node="@root" Depth="0" />
                            }
                        </ul>
                    </div>
                </div>
            </CascadingValue>
        </section>
    </div>
}
