@* Renders into the header, so a page still declares its trail beside the data it built it
   from. *@
<SectionContent SectionId="Breadcrumb.HeaderSection">
    @if (Items.Count > 0)
    {
        <nav aria-label="Breadcrumb">
            <ol class="crumbs">
                @foreach (var item in Items)
                {
                    var last = item == Items[^1];

                    <li aria-current="@(last ? "page" : null)">
                        @if (last || item.Href is null)
                        {
                            @item.Text
                        }
                        else
                        {
                            <a href="@item.Href">@item.Text</a>
                        }
                    </li>
                }
            </ol>
        </nav>
    }
</SectionContent>
