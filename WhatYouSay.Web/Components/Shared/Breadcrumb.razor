@if (Items.Count > 0)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            @foreach (var item in Items)
            {
                var last = item == Items[^1];

                <li class="breadcrumb-item @(last ? "active" : "")" aria-current="@(last ? "page" : null)">
                    @if (last || item.Href is null)
                    {
                        @item.Text
                    }
                    else
                    {
                        <a href="@item.Href">@item.Text</a>
                    }
                </li>
            }
        </ol>
    </nav>
}
