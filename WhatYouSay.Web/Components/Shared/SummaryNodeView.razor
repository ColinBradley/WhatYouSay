@using WhatYouSay.Data
@using WhatYouSay.Services

<li class="@this.ItemClass()">
    @if (this.Depth == 0)
    {
        <h2 class="h4 mb-1">@this.Node.Text</h2>
    }
    else
    {
        <div>@this.Node.Text</div>
    }

    @if (this.Node.References.Count > 0)
    {
        <details class="mt-1">
            <summary class="small text-body-secondary">
                @this.Node.References.Count
                @(this.Node.References.Count == 1 ? "quote" : "quotes")
            </summary>

            @foreach (var reference in this.Node.References)
            {
                <figure class="mt-2 mb-2 ps-3 border-start">
                    @if (this.Reading.ResponsesArePublic && Highlight(reference) is { } context)
                    {
                        <blockquote class="mb-1 small">
                            <span class="text-body-secondary">@context.Before</span><mark>@context.Quote</mark><span class="text-body-secondary">@context.After</span>
                        </blockquote>
                    }
                    else
                    {
                        <blockquote class="mb-1">&ldquo;@reference.Quote&rdquo;</blockquote>
                    }

                    <figcaption class="small text-body-secondary">
                        @(reference.Response.Author ?? "anonymous")
                    </figcaption>
                </figure>
            }
        </details>
    }
    else if (this.Inherited)
    {
        <div class="small text-body-secondary fst-italic mt-1">
            Rests on the quotes above rather than any of its own.
        </div>
    }
    else
    {
        <div class="small text-warning-emphasis fst-italic mt-1">
            Nobody is quoted for this, here or above it.
        </div>
    }

    <div class="d-flex gap-1 align-items-center mt-2 flex-wrap">
        @foreach (var kind in SummaryReading.Reactions)
        {
            <button type="submit" name="Action" class="btn btn-sm @Pressed(this.Tally, kind)"
                    value="@($"{this.Node.Id}:{kind}")" title="@Label(kind)">
                @Emoji(kind)@(this.Tally.CountOf(kind) > 0 ? $" {this.Tally.CountOf(kind)}" : "")
            </button>
        }
    </div>

    @{
        var comments = this.Reading.CommentsFor(this.Node.Id);
    }

    <details class="mt-2" open="@(comments.Count > 0)">
        <summary class="small text-body-secondary">
            @(comments.Count == 0
                ? "Comment"
                : $"{comments.Count} {(comments.Count == 1 ? "comment" : "comments")}")
        </summary>

        @foreach (var comment in comments)
        {
            <div class="border-start ps-3 mt-2 @(comment.IsHidden ? "opacity-50" : null)">
                <div class="small">&ldquo;@comment.Body&rdquo;</div>

                <div class="small text-body-secondary">
                    @(comment.Author ?? "anonymous")

                    @if (comment.IsHidden)
                    {
                        <span class="badge text-bg-secondary ms-1">Hidden</span>
                    }

                    @if (comment.IsMine)
                    {
                        <button type="submit" name="Action" class="btn btn-sm btn-link p-0 ms-1 align-baseline"
                                value="@($"comment:{comment.Id}:{(comment.IsHidden ? "show" : "hide")}")">
                            @(comment.IsHidden ? "Show" : "Hide")
                        </button>
                    }
                </div>
            </div>
        }

        <textarea class="form-control form-control-sm mt-2" rows="2"
                  name="@SummaryReading.CommentField(this.Node.Id)"
                  placeholder="Say something about this"></textarea>

        <button type="submit" name="Action" class="btn btn-sm btn-outline-secondary mt-2"
                value="@($"comment:{this.Node.Id}:add")">
            Add comment
        </button>
    </details>
    @if (this.Node.Children.Count > 0)
    {
        @if (this.Collapse())
        {
            <details class="mt-2">
                <summary class="small text-body-secondary">
                    @this.Node.Children.Count more below
                </summary>

                <SummaryNodeList Nodes="@this.Node.Children" Depth="@(this.Depth + 1)"
                                 Inherited="@this.PassesSupportDown()" />
            </details>
        }
        else
        {
            <SummaryNodeList Nodes="@this.Node.Children" Depth="@(this.Depth + 1)"
                             Inherited="@this.PassesSupportDown()" />
        }
    }
</li>
