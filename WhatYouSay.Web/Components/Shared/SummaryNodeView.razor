@using WhatYouSay.Data
@using WhatYouSay.Services

@{
    var comments = this.Reader.CommentsFor(this.Node.Id);
}

<li id="@($"node-{this.Node.Id}")">
    @* The hover target is this node's head alone. Widening it to the <li> would take in the
       gaps between children and the comment box, and both hold the controls open. *@
    <div class="node-head hoverable">
        <div class="node-text">@this.Node.Text</div>

        @if (this.Node.References.Count > 0)
        {
            <div class="fine citations">
                @foreach (var reference in this.Node.References)
                {
                    @if (this.Reader.ResponsesArePublic)
                    {
                        @* app.js scrolls the pane alone; an href moves the page with it. *@
                        <button type="button" class="bare" data-shows-quote="@reference.Id"
                                title="@($"“{reference.Quote}”")">
                            @(reference.Response.Author ?? "anonymous")
                        </button>
                    }
                    else
                    {
                        <span title="@($"“{reference.Quote}”")">
                            @(reference.Response.Author ?? "anonymous")
                        </span>
                    }
                }
            </div>
        }

        <div class="node-actions">
            @foreach (var kind in SummaryNodeView.Reactions)
            {
                @if (this.Tally.CountOf(kind) == 0 && !this.Tally.Mine.Contains(kind))
                {
                    <button type="button" class="reaction" title="@Label(kind)"
                            @onclick="() => this.Reader.ToggleAsync(this.Node.Id, kind)">
                        @Emoji(kind)
                    </button>
                }
            }

            @if (comments.Count == 0)
            {
                @* Opens the thread below. In the floating cluster, so nothing moves as the
                   pointer arrives. *@
                <button type="button" class="bare" data-opens="@($"comments-{this.Node.Id}")">
                    Comment
                </button>
            }
        </div>

        <div class="reactions">
            @foreach (var kind in SummaryNodeView.Reactions)
            {
                var count = this.Tally.CountOf(kind);
                var mine = this.Tally.Mine.Contains(kind);

                @if (count > 0 || mine)
                {
                    <button type="button" class="reaction @(mine ? "mine" : null)"
                            title="@Label(kind)"
                            @onclick="() => this.Reader.ToggleAsync(this.Node.Id, kind)">
                        @Emoji(kind)@(count > 0 ? $" {count}" : "")
                    </button>
                }
            }
        </div>
    </div>

    <details class="comments @(comments.Count == 0 ? "unasked" : null)"
             id="@($"comments-{this.Node.Id}")">
        <summary class="fine">
            @(comments.Count == 0
                ? "Comment"
                : $"{comments.Count} {(comments.Count == 1 ? "comment" : "comments")}")
        </summary>

        <div class="panel stack wide">
            <div class="comment-form">
                <textarea rows="2" placeholder="Say something about this"
                          value="@this.Reader.DraftFor(this.Node.Id)"
                          @onchange="@(e => this.Reader.SetDraft(this.Node.Id, e.Value?.ToString() ?? string.Empty))"></textarea>

                <button type="button" @onclick="() => this.Reader.AddCommentAsync(this.Node.Id)">
                    Add comment
                </button>
            </div>

            @foreach (var comment in comments)
            {
                <div class="comment @(comment.IsHidden ? "is-hidden" : null)">
                    <div>@comment.Body</div>

                    <div class="fine">
                        @(comment.Author ?? "anonymous")

                        @if (comment.IsHidden)
                        {
                            <span class="tag">Hidden</span>
                        }

                        @if (comment.IsMine || this.Reader.IsAdmin)
                        {
                            <button class="bare" type="button"
                                    @onclick="() => this.Reader.SetCommentHiddenAsync(comment.Id, !comment.IsHidden)">
                                @(comment.IsHidden ? "Show" : "Hide")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </details>

    @if (this.Node.Children.Count > 0)
    {
        <SummaryNodeList Nodes="@this.Node.Children" Depth="@(this.Depth + 1)" />
    }
</li>
