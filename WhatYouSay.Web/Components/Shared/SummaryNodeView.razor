@using WhatYouSay.Data
@using WhatYouSay.Services

@{
    var comments = this.Reading.CommentsFor(this.Node.Id);
}

<li id="@($"node-{this.Node.Id}")">
    @*
        The hover target is the node's own text and nothing else. It used to be the whole
        <li>, which swallowed the gaps between children and the comment box: crossing a gap
        lit the parent up, and a caret in the box held its controls open indefinitely.
    *@
    <div class="node-head hoverable">
        <div class="node-text">@this.Node.Text</div>

        @if (this.Node.References.Count > 0)
        {
            <div class="fine citations">
                @foreach (var reference in this.Node.References)
                {
                    @if (this.Reading.ResponsesArePublic)
                    {
                        @* A button, not a link: app.js scrolls the pane on its own, where an
                           href moves the page under it as well. *@
                        <button type="button" class="bare" data-shows-quote="@reference.Id"
                                title="@($"“{reference.Quote}”")">
                            @(reference.Response.Author ?? "anonymous")
                        </button>
                    }
                    else
                    {
                        <span title="@($"“{reference.Quote}”")">
                            @(reference.Response.Author ?? "anonymous")
                        </span>
                    }
                }
            </div>
        }

        <div class="node-actions">
            @foreach (var kind in SummaryReading.Reactions)
            {
                @if (this.Tally.CountOf(kind) == 0 && !this.Tally.Mine.Contains(kind))
                {
                    <button type="submit" name="Action" class="reaction" title="@Label(kind)"
                            value="@($"{this.Node.Id}:{kind}")">
                        @Emoji(kind)
                    </button>
                }
            }

            @if (comments.Count == 0)
            {
                @* Opens the thread below. In the floating cluster rather than beside it, so
                   nothing on the page moves as the pointer arrives. *@
                <button type="button" class="bare" data-opens="@($"comments-{this.Node.Id}")">
                    Comment
                </button>
            }
        </div>

        <div class="reactions">
            @foreach (var kind in SummaryReading.Reactions)
            {
                var count = this.Tally.CountOf(kind);
                var mine = this.Tally.Mine.Contains(kind);

                @if (count > 0 || mine)
                {
                    <button type="submit" name="Action" class="reaction @(mine ? "mine" : null)"
                            title="@Label(kind)" value="@($"{this.Node.Id}:{kind}")">
                        @Emoji(kind)@(count > 0 ? $" {count}" : "")
                    </button>
                }
            }
        </div>
    </div>

    @* Closed by default either way: the count is the news, the thread is the follow-up. *@
    <details class="comments @(comments.Count == 0 ? "unasked" : null)"
             id="@($"comments-{this.Node.Id}")">
        <summary class="fine">
            @(comments.Count == 0
                ? "Comment"
                : $"{comments.Count} {(comments.Count == 1 ? "comment" : "comments")}")
        </summary>

        @* The box sits above the thread: saying something is the reason to open this. *@
        <div class="panel stack wide">
            <textarea rows="2" name="@SummaryReading.CommentField(this.Node.Id)"
                      placeholder="Say something about this"></textarea>

            <button type="submit" name="Action" value="@($"comment:{this.Node.Id}:add")">
                Add comment
            </button>

            @foreach (var comment in comments)
            {
                <div class="comment @(comment.IsHidden ? "is-hidden" : null)">
                    <div>@comment.Body</div>

                    <div class="fine">
                        @(comment.Author ?? "anonymous")

                        @if (comment.IsHidden)
                        {
                            <span class="tag">Hidden</span>
                        }

                        @if (comment.IsMine)
                        {
                            <button class="bare" type="submit" name="Action"
                                    value="@($"comment:{comment.Id}:{(comment.IsHidden ? "show" : "hide")}")">
                                @(comment.IsHidden ? "Show" : "Hide")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </details>

    @if (this.Node.Children.Count > 0)
    {
        <SummaryNodeList Nodes="@this.Node.Children" Depth="@(this.Depth + 1)"
                         Inherited="@this.PassesSupportDown()" />
    }
</li>
